# Copy to keystore.properties (gitignored) and fill in. Paths are relative to the android/ folder.
# If you use the Play upload key in android/seceett/:
# storeFile=seceett/upload-keystore.jks
storeFile=your-upload-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
