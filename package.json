{
  "name": "bonyad-app",
  "version": "1.0.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "start:fresh": "rm -rf node_modules/.cache .expo/cache && expo start --clear",
    "start:enumerator": "expo start --port 8083 --clear",
    "android": "expo run:android",
    "android:deep-clean": "rm -rf android/app/.cxx android/.cxx android/app/build android/build && cd android && ./gradlew clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "device": "expo start",
    "clear": "expo start --clear",
    "dev": "./dev.sh",
    "build": "npm run build:apk",
    "build:aab": "./scripts/build-aab.sh",
    "build:web": "npx expo export --platform web --output-dir web-build && node scripts/update-asset-paths.js",
    "build:apk": "./scripts/build-apk.sh",
    "build:dev:android": "eas build --profile development --platform android",
    "build:prod:android": "eas build --profile production --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.0.3",
    "@react-google-maps/api": "^2.20.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.5.0",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/messaging": "^23.4.1",
    "@react-native-picker/picker": "^2.11.4",
    "@stomp/stompjs": "^7.2.1",
    "expo": "54.0.20",
    "expo-asset": "~12.0.9",
    "expo-av": "~16.0.7",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-intent-launcher": "~13.0.7",
    "expo-linear-gradient": "~15.0.8",
