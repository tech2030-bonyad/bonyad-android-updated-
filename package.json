    "mqtt": "^5.15.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.0.1",
    "react-native": "0.81.5",
    "react-native-blob-util": "^0.24.7",
    "react-native-copilot": "^3.3.3",
    "react-native-maps": "^1.26.18",
